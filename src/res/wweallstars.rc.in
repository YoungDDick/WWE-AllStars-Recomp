// The game exe's icon and version information. CMakeLists.txt configures this
// file; SDL registers the window class with the exe's first icon group, so
// Explorer, the taskbar, Alt+Tab and the title bar all show it.

1 ICON "@WWEALLSTARS_ICON@"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "WWE All Stars Recomp contributors"
            VALUE "FileDescription", "WWE All Stars Recomp (fan project, not affiliated with WWE, THQ, Yuke's or Microsoft)"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "wweallstars"
            VALUE "LegalCopyright", "WWE All Stars Recomp contributors. BSD-3-Clause."
            VALUE "OriginalFilename", "wweallstars.exe"
            VALUE "ProductName", "WWE All Stars Recomp"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
