<Project Sdk="Microsoft.NET.Sdk">
  <!-- The launcher's decisions, with no UI types: the test seam (spec, "Architecture"). -->
  <PropertyGroup>
    <RootNamespace>WweAllStars.Launcher.Core</RootNamespace>
    <AssemblyName>WweAllStars.Launcher.Core</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The XenosRecomp patch the game is configured with (CMakeLists.txt hashes the same file). -->
    <XenosRecompPatch>$(MSBuildThisFileDirectory)../../../patches/xenosrecomp-wweallstars.patch</XenosRecompPatch>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpCompress" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated by scripts/inspect_disc.py (manifest option): paths, sizes and hashes, no game data. -->
    <EmbeddedResource Include="../../disc-manifest.tsv" LogicalName="disc-manifest.tsv" />
    <!-- Title Update 2's 13 files: paths, sizes and hashes, no game data. -->
    <EmbeddedResource Include="../../tu2-manifest.tsv" LogicalName="tu2-manifest.tsv" />
    <!-- The game's settings list, exported by scripts/export-settings-schema.ps1. -->
    <EmbeddedResource Include="SettingsSchema.json" LogicalName="SettingsSchema.json" />
  </ItemGroup>

  <!--
    The converter ID a shader pack must carry for this build's game: the first 16 hex digits of
    the patch's SHA-256, as CMakeLists.txt computes WWE_EXPECTED_SHADER_CONVERTER_ID.
  -->
  <Target Name="ShaderConverterIdPath">
    <PropertyGroup>
      <!-- In obj/: IntermediateOutputPath is only known once the SDK's targets are imported. -->
      <ShaderConverterIdFile>$([System.IO.Path]::Combine($(MSBuildProjectDirectory), $(IntermediateOutputPath), 'ShaderConverterId.g.cs'))</ShaderConverterIdFile>
    </PropertyGroup>
  </Target>
  <Target Name="GenerateShaderConverterId" BeforeTargets="CoreCompile" DependsOnTargets="ShaderConverterIdPath" Inputs="$(XenosRecompPatch)" Outputs="$(ShaderConverterIdFile)">
    <GetFileHash Files="$(XenosRecompPatch)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="XenosRecompPatchHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(ShaderConverterIdFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated from patches/xenosrecomp-wweallstars.patch by Launcher.Core.csproj.;namespace WweAllStars.Launcher.Core%3B;public static partial class ShaderConverter { public const ulong Id = 0x$(XenosRecompPatchHash.Substring(0, 16))UL%3B }" />
  </Target>
  <Target Name="IncludeShaderConverterId" BeforeTargets="CoreCompile" AfterTargets="GenerateShaderConverterId" DependsOnTargets="ShaderConverterIdPath">
    <ItemGroup>
      <Compile Include="$(ShaderConverterIdFile)" />
      <FileWrites Include="$(ShaderConverterIdFile)" />
    </ItemGroup>
  </Target>
</Project>
