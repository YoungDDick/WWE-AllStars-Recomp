+// A TOML basic string: backslashes and quotes escaped, so Windows paths keep
+// the file parseable (unescaped, the loader rejects the whole config).
+static std::string TomlQuoted(const std::string& value) {
+  std::string quoted = "\"";
+  for (char c : value) {
+    if (c == '"' || c == '\\') {
+      quoted += '\\';
+    }
+    quoted += c;
+  }
+  return quoted + "\"";
+}
