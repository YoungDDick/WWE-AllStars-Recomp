+++ b/include/rex/kernel/xam/live/live.h
@@ -0,0 +1,69 @@
+/**
+ * @file        live.h
+ * @brief       --wwe_online: Xbox LIVE sign-in against the game server.
+ *
+ * WWE All Stars recomp, online play (.scratch/online-play/, ADR-0021). With --wwe_online
+ * the profile signs in to Live, registers with the game server's XWS API (whoami,
+ * players) and lists the server's Rendez-Vous address as the title's LSP. The client
+ * follows the Xenia netplay fork (AdrianCassar/xenia-canary, 6dbaa1f, BSD license).
+ * Off by default; off, nothing here runs.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/kernel/xam/live/xlive_json.h>
+
+REXCVAR_DECLARE(bool, wwe_online);
+REXCVAR_DECLARE(std::string, wwe_online_server);
+REXCVAR_DECLARE(std::string, wwe_online_ip);
+REXCVAR_DECLARE(std::string, wwe_online_name);
+
+namespace rex::kernel::xam::live {
+
+// --wwe_online.
+bool Enabled();
+
+// Enabled, and the game server answered: the profile is signed in to Live. The first call
+// loads the identity and registers with the server.
+bool SignedIn();
+
+// The install's online XUID and MAC (online-identity.json).
+uint64_t OnlineXuid();
+std::array<uint8_t, 6> Mac();
+
+// --wwe_online_name, or the profile's gamertag.
+std::string Gamertag();
+
+// --wwe_online_ip in host order: the copy's peer sockets bind to it (PlanBind). 0 when
+// unset.
+uint32_t BindAddress();
+
+// The address the server sees this copy at (whoami, XNADDR inaOnline), host order; 0
+// before sign-in.
+uint32_t OnlineAddress();
+
+// This copy's address on its own network (XNADDR ina): --wwe_online_ip, else the address
+// its requests to the server leave from. 0 before sign-in.
+uint32_t LocalAddress();
+
+// The game server's LSP list (title/{id}/servers).
+std::vector<TitleServer> TitleServers();
+
+// The player the server has at an address, public or local (players/find).
+std::optional<PlayerRecord> FindPlayer(uint32_t address);
+// The player with an XNADDR's MAC (abEnet), or with a XUID.
+std::optional<PlayerRecord> FindPlayerByMac(const std::array<uint8_t, 6>& mac);
+std::optional<PlayerRecord> FindPlayerByXuid(uint64_t xuid);
+
+// A hosted session's QoS data (XNetQosListen), for searchers' XNetQosLookup.
+void PostQosData(uint64_t session_id, const std::string& data);
+std::string GetQosData(uint64_t session_id);
+
+}  // namespace rex::kernel::xam::live
diff --git a/include/rex/kernel/xam/live/port_map.h b/include/rex/kernel/xam/live/port_map.h
new file mode 100644
index 0000000..6e14b8f
--- /dev/null
+++ b/include/rex/kernel/xam/live/port_map.h
@@ -0,0 +1,69 @@
+/**
+ * @file        port_map.h
+ * @brief       UPnP port mappings (ticket 18): a player's game ports and the router's
+ *              external ports they are reached at.
+ *
+ * A player with --wwe_online_upnp registers its mappings; a peer reaching it at its
+ * public address sends to the external ports, and datagrams from those ports reach the
+ * game from the game's own ports.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <mutex>
+
+namespace rex::kernel::xam::live {
+
+// Game port -> the router's external port.
+using PortMap = std::map<uint16_t, uint16_t>;
+
+inline uint16_t ExternalPort(const PortMap& ports, uint16_t game_port) {
+  const auto found = ports.find(game_port);
+  return found == ports.end() ? game_port : found->second;
+}
+
+inline uint16_t GamePort(const PortMap& ports, uint16_t external_port) {
+  for (const auto& [game, external] : ports) {
+    if (external == external_port) {
+      return game;
+    }
+  }
+  return external_port;
+}
+
+// The external port to ask the router for: the game port itself, then a thousand higher
+// for each attempt the router refused (another device holds the port).
+constexpr uint16_t CandidateExternalPort(uint16_t game_port, int attempt) {
+  return uint16_t(game_port + 1000 * attempt);
+}
+
+// The peers reached at their public address, with their mappings.
+class PeerPorts {
+ public:
+  void Remember(uint32_t address, const PortMap& ports) {
+    std::lock_guard lock(mutex_);
+    if (ports.empty()) {
+      by_address_.erase(address);
+    } else {
+      by_address_[address] = ports;
+    }
+  }
+  uint16_t External(uint32_t address, uint16_t game_port) const {
+    std::lock_guard lock(mutex_);
+    const auto found = by_address_.find(address);
+    return found == by_address_.end() ? game_port : ExternalPort(found->second, game_port);
+  }
+  uint16_t Game(uint32_t address, uint16_t external_port) const {
+    std::lock_guard lock(mutex_);
+    const auto found = by_address_.find(address);
+    return found == by_address_.end() ? external_port : GamePort(found->second, external_port);
+  }
+
+ private:
+  mutable std::mutex mutex_;
+  std::map<uint32_t, PortMap> by_address_;
+};
+
+}  // namespace rex::kernel::xam::live
diff --git a/include/rex/kernel/xam/live/relay.h b/include/rex/kernel/xam/live/relay.h
new file mode 100644
index 0000000..81a85ea
--- /dev/null
+++ b/include/rex/kernel/xam/live/relay.h
@@ -0,0 +1,54 @@
+/**
+ * @file        relay.h
+ * @brief       The peer transport through the game server's relay (ticket 16).
+ *
+ * A relayed peer is reached at a stand-in loopback address (relay_protocol.h). The
+ * transport listens there on the game's peer ports (VDP 1000, UDP 9100): what the game
+ * sends to a stand-in goes to the relay wrapped for that peer, and what the relay delivers
+ * from a peer reaches the game from the peer's stand-in address and port. The game sees no
+ * difference.
+ *
+ * Without --wwe_online_force_relay a peer is probed directly first (ticket 17): it is
+ * reached directly when it answers, through the relay otherwise.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <optional>
+
+#include <rex/cvar.h>
+#include <rex/kernel/xam/live/relay_protocol.h>
+
+REXCVAR_DECLARE(bool, wwe_online_force_relay);
+REXCVAR_DECLARE(bool, wwe_online_drop_direct);
+
+namespace rex::kernel::xam::live::relay {
+
+// --wwe_online_force_relay: every peer goes through the relay.
+bool Forced();
+
+// Answers direct probes on the probe port at --wwe_online_ip (0: every address), from
+// before registration on: the server checks a UPnP player's mapped probe port then.
+void ListenForProbes(uint32_t copy_address);
+
+// After sign-in: the relay's address and port, this player's XUID and token, and
+// --wwe_online_ip (0 when unset), where the game's peer sockets listen. Starts the
+// transport.
+void Configure(uint32_t relay_address, uint16_t relay_port, uint64_t own_xuid,
+               const Token& token, uint32_t copy_address);
+bool Configured();
+
+// The address the game reaches a peer at: `direct` once the peer answered a direct probe,
+// else its stand-in address (listening once this returns). The first call for a peer
+// probes it, waiting up to about 0.6 s; the choice is logged and kept for the session.
+uint32_t AddressFor(uint64_t peer_xuid, uint32_t direct);
+
+// --wwe_online_drop_direct (developer): a datagram to a peer port that is not a stand-in
+// address is dropped, and probes go unanswered, as if the peers could not reach each other.
+bool DropsDirect(uint32_t address, uint16_t port);
+
+// The peer behind a stand-in address.
+std::optional<uint64_t> PeerAt(uint32_t address);
+
+}  // namespace rex::kernel::xam::live::relay
diff --git a/include/rex/kernel/xam/live/relay_protocol.h b/include/rex/kernel/xam/live/relay_protocol.h
new file mode 100644
index 0000000..96a627e
--- /dev/null
+++ b/include/rex/kernel/xam/live/relay_protocol.h
@@ -0,0 +1,87 @@
+/**
+ * @file        relay_protocol.h
+ * @brief       The game server's relay: its wire format, the stand-in addresses of
+ *              relayed peers, and each peer's route (direct or relayed).
+ *
+ * The wire format is server/internal/relay's (see there): "ASR1", a type byte, then
+ * big-endian fields. A relayed peer is reached at a stand-in loopback address, as a real
+ * Xbox hands out a secure address per peer; the transport (relay.h) listens there.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <optional>
+#include <string_view>
+#include <vector>
+
+namespace rex::kernel::xam::live::relay {
+
+using Token = std::array<uint8_t, 16>;
+
+// The registration's relayToken (32 hex digits).
+std::optional<Token> ParseToken(std::string_view hex);
+
+std::vector<uint8_t> Hello(uint64_t xuid, const Token& token);
+std::vector<uint8_t> Ping(uint64_t stamp);
+// A game datagram for player `to`, from the game's port `src` to its port `dst`.
+std::vector<uint8_t> Send(uint64_t to, uint16_t src, uint16_t dst, const uint8_t* payload,
+                          size_t size);
+
+// What the relay sends a player.
+struct Message {
+  enum Kind { kWelcome, kPong, kDeliver } kind;
+  uint64_t value = 0;  // welcome: own XUID; pong: the ping's stamp; deliver: the sender
+  uint16_t src_port = 0;
+  uint16_t dst_port = 0;
+  const uint8_t* payload = nullptr;  // into the parsed buffer
+  size_t size = 0;
+};
+std::optional<Message> Parse(const uint8_t* data, size_t size);
+
+// 127.200.0.1: the first stand-in address.
+constexpr uint32_t kFirstStandIn = 0x7FC80001;
+
+// Relayed peers and their stand-in addresses.
+class PeerTable {
+ public:
+  // The peer's stand-in address: the one it has, else the first free candidate `usable`
+  // accepts (the transport binds there; another copy on this PC may hold it).
+  std::optional<uint32_t> Add(uint64_t xuid, const std::function<bool(uint32_t)>& usable);
+  std::optional<uint64_t> XuidAt(uint32_t stand_in) const;
+  std::optional<uint32_t> StandInFor(uint64_t xuid) const;
+
+ private:
+  std::map<uint64_t, uint32_t> by_xuid_;
+  std::map<uint32_t, uint64_t> by_address_;
+};
+
+// The direct probe (ticket 17): a copy asks a peer's probe port whether it can reach the
+// peer at all; "ASP1", a type byte, the nonce. The answer echoes the nonce.
+constexpr uint16_t kProbePort = 9101;
+std::vector<uint8_t> Probe(uint64_t nonce);
+std::vector<uint8_t> ProbeAnswer(uint64_t nonce);
+std::optional<uint64_t> ParseProbe(const uint8_t* data, size_t size);
+std::optional<uint64_t> ParseProbeAnswer(const uint8_t* data, size_t size);
+
+enum class Route { kUndecided, kDirect, kRelay };
+
+// Each peer's route for the session: a probe settles it, and it stays put after.
+class RouteTable {
+ public:
+  Route Get(uint64_t xuid) const;
+  // The probe was answered or timed out; returns the peer's route.
+  Route Settle(uint64_t xuid, bool answered);
+  // The relay delivered from this peer: an undecided peer is settled on the relay, so both
+  // sides of a pair agree.
+  void Relayed(uint64_t xuid);
+
+ private:
+  std::map<uint64_t, Route> routes_;
+};
+
+}  // namespace rex::kernel::xam::live::relay
diff --git a/include/rex/kernel/xam/live/session_data.h b/include/rex/kernel/xam/live/session_data.h
new file mode 100644
index 0000000..5eee420
--- /dev/null
+++ b/include/rex/kernel/xam/live/session_data.h
@@ -0,0 +1,93 @@
+/**
+ * @file        session_data.h
+ * @brief       Xbox LIVE session data: contexts, properties, the server's session records,
+ *              and search results in guest memory.
+ *
+ * After the Xenia netplay fork's XSession and XLiveAPI session calls
+ * (src/xenia/kernel/xsession.cc, XLiveAPI.cpp; Copyright 2026 Xenia Canary, BSD license).
+ * Properties travel as JSON objects ({id, type, bytes}) rather than the fork's host-endian
+ * binary blobs; server/internal/xws stores them as given.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace rex::kernel::xam::live {
+
+// XUSER_DATA types; a property ID carries its type in the top nibble.
+inline constexpr uint8_t kUserDataContext = 0;
+inline constexpr uint8_t kUserDataInt32 = 1;
+inline constexpr uint8_t kUserDataInt64 = 2;
+inline constexpr uint8_t kUserDataDouble = 3;
+inline constexpr uint8_t kUserDataWString = 4;
+inline constexpr uint8_t kUserDataFloat = 5;
+inline constexpr uint8_t kUserDataBinary = 6;
+inline constexpr uint8_t kUserDataDateTime = 7;
+
+struct UserContext {
+  uint32_t id = 0;
+  uint32_t value = 0;
+  bool operator==(const UserContext&) const = default;
+};
+
+// A property value as the guest set it: big-endian numbers, UTF-16BE text with its
+// terminator, raw bytes. It travels base64-encoded ("bytes"); ParseSessions also reads
+// "int" and "double" values.
+struct UserProperty {
+  uint32_t id = 0;
+  uint8_t type = 0;
+  std::vector<uint8_t> value;
+};
+
+// XGIUserSetPropertyEx's value (`size` bytes at `data`) for property `id`.
+UserProperty GuestProperty(uint32_t id, const uint8_t* data, uint32_t size);
+
+struct SessionRecord {
+  uint64_t session_id = 0;
+  uint64_t host_xuid = 0;
+  uint32_t flags = 0;
+  uint32_t public_slots = 0;
+  uint32_t private_slots = 0;
+  uint32_t open_public = 0;
+  uint32_t open_private = 0;
+  uint32_t filled_public = 0;
+  uint32_t filled_private = 0;
+  std::string host_address;   // public
+  std::string local_address;  // on the host's own network; empty: the public one
+  std::array<uint8_t, 6> mac = {};
+  uint16_t port = 0;
+  std::string build_id;
+  std::vector<UserContext> contexts;
+  std::vector<UserProperty> properties;
+};
+
+// POST title/{id}/sessions.
+std::string SessionJson(const SessionRecord& session, uint32_t user_index);
+// POST title/{id}/sessions/{id}/properties.
+std::string PropertiesJson(const std::vector<UserContext>& contexts,
+                           const std::vector<UserProperty>& properties);
+// POST title/{id}/sessions/search.
+std::string SearchJson(uint32_t search_index, uint32_t results, uint32_t users,
+                       uint64_t searcher_xuid, const std::string& build_id,
+                       const std::vector<UserContext>& contexts);
+// A search reply (an array) or one session (an object).
+std::vector<SessionRecord> ParseSessions(std::string_view body);
+
+// XSESSION_SEARCHRESULT_HEADER, the XSESSION_SEARCHRESULTs, then their contexts, properties
+// and property data, as the guest buffer at `guest_base` (big-endian, at most
+// `buffer_size` bytes). Sessions that don't fit are left out.
+std::vector<uint8_t> PackSearchResults(const std::vector<SessionRecord>& sessions,
+                                       uint32_t guest_base, uint32_t buffer_size);
+
+// XSESSION_INFO (0x3C bytes): the session ID, the host's XNADDR (local address in ina,
+// public in inaOnline) and the key-exchange key.
+void WriteSessionInfo(uint8_t* out, uint64_t session_id, uint32_t local_address,
+                      uint32_t public_address, const std::array<uint8_t, 6>& mac,
+                      uint16_t port);
+
+}  // namespace rex::kernel::xam::live
diff --git a/include/rex/kernel/xam/live/upnp.h b/include/rex/kernel/xam/live/upnp.h
new file mode 100644
index 0000000..0ee11a4
--- /dev/null
+++ b/include/rex/kernel/xam/live/upnp.h
@@ -0,0 +1,33 @@
+/**
+ * @file        upnp.h
+ * @brief       --wwe_online_upnp: the game's peer ports mapped on the router (ticket 18).
+ *
+ * After the Xenia netplay fork's UPnP class (src/xenia/kernel/upnp.cc, Copyright 2026
+ * Xenia Canary, BSD license), with miniupnpc at the fork's pinned commit. Off by default:
+ * without the switch no UPnP traffic is sent.
+ */
+
+#pragma once
+
+#include <rex/cvar.h>
+#include <rex/kernel/xam/live/port_map.h>
+
+REXCVAR_DECLARE(bool, wwe_online_upnp);
+
+namespace rex::kernel::xam::live::upnp {
+
+bool Enabled();
+
+// The first call (with the switch on) finds the router and maps UDP 1000, 9100 and the
+// probe port to this PC, keeping the leases fresh. Game port -> external port; empty when
+// the switch is off or no router answered.
+PortMap MapPorts();
+
+// Removes the mappings; the window's close runs it before the process ends.
+void RemoveMappings();
+
+// Peers reached at their public address and the router ports they mapped, for the
+// datagrams to and from them.
+PeerPorts& Peers();
+
+}  // namespace rex::kernel::xam::live::upnp
diff --git a/include/rex/kernel/xam/live/xlive_json.h b/include/rex/kernel/xam/live/xlive_json.h
new file mode 100644
index 0000000..b5789dd
--- /dev/null
+++ b/include/rex/kernel/xam/live/xlive_json.h
@@ -0,0 +1,73 @@
+/**
+ * @file        xlive_json.h
+ * @brief       The JSON the online client exchanges with the game server's XWS API.
+ *
+ * Shapes follow the Xenia netplay fork (AdrianCassar/xenia-canary,
+ * netplay_canary_experimental 6dbaa1f, src/xenia/kernel/json/), BSD-licensed; the server
+ * side is server/internal/xws.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include <rex/kernel/xam/live/port_map.h>
+
+namespace rex::kernel::xam::live {
+
+// --wwe_online_server as the API's base URL: "host" and "host:port" get http:// (port
+// 36000 by default), a URL is kept; always one trailing slash.
+std::string ApiBaseUrl(std::string_view server);
+
+// GET whoami: the address the server sees this copy at.
+std::optional<std::string> ParseWhoami(std::string_view body);
+
+struct PlayerRecord {
+  uint64_t xuid = 0;
+  uint64_t machine_id = 0;
+  std::string host_address;   // public: the address whoami gave
+  std::string local_address;  // on its own network (XNADDR ina)
+  std::string gamertag;
+  std::array<uint8_t, 6> mac = {};
+  std::string build_id;  // see BuildId(); sent, never parsed
+  PortMap mapped_ports;  // --wwe_online_upnp: game port -> the router's external port
+};
+
+// The game the port is built on (WWE All Stars Recomp 1.0.0: Title Update 2), sent at sign-in;
+// a game server for another version refuses the player (tu2-dlc ticket 06).
+inline constexpr const char* kGameVersion = "tu2";
+
+// The POST players reply: the relay's "address:port" and this player's token for it, and,
+// for a player with mapped ports, whether the server reached the mapped probe port.
+struct Registration {
+  std::string relay_address;
+  std::string relay_token;
+  std::optional<bool> reachable;
+};
+std::optional<Registration> ParseRegistration(std::string_view body);
+
+// The message of a refused sign-in (HTTP 426: the server runs another game version).
+std::optional<std::string> ParseRefusal(std::string_view body);
+
+// POST players body, and the players/find reply.
+std::string PlayerJson(const PlayerRecord& player);
+std::optional<PlayerRecord> ParsePlayer(std::string_view body);
+
+struct TitleServer {
+  uint32_t address = 0;  // host order
+  uint32_t flags = 0;
+  std::string description;
+};
+
+// GET title/{id}/servers: the LSP servers XTitleServerCreateEnumerator lists.
+std::vector<TitleServer> ParseTitleServers(std::string_view body);
+
+// "a.b.c.d" in host order, or nullopt.
+std::optional<uint32_t> ParseIPv4(std::string_view text);
+
+}  // namespace rex::kernel::xam::live
