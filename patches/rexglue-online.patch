+/**
+ * @file        xsession.h
+ * @brief       Xbox LIVE sessions (XSession*) against the game server's XWS API.
+ *
+ * WWE All Stars recomp, online play. Ported in part from the Xenia netplay fork's XSession
+ * (src/xenia/kernel/xsession.cc, Copyright 2026 Xenia Canary, BSD license): Player Match
+ * hosting, search, details, modify, delete, join and leave. No arbitration, stats or
+ * migration. Only used with --wwe_online; otherwise the session messages keep their stubs.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <rex/kernel/xam/live/session_data.h>
+#include <rex/system/xobject.h>
+#include <rex/system/xtypes.h>
+
+namespace rex::kernel::xam::live {
+
+// The contexts and properties the game sets for a user (XGIUserSetContextEx and
+// XGIUserSetPropertyEx); a hosted session advertises them.
+void SetUserContext(uint32_t user_index, uint32_t id, uint32_t value);
+void SetUserProperty(uint32_t user_index, const UserProperty& property);
+std::vector<UserContext> UserContexts(uint32_t user_index);
+std::vector<UserProperty> UserProperties(uint32_t user_index);
+
+// The SHA-256 of the running executable (hex): only copies of the same build see each
+// other's sessions. Computed once.
+const std::string& BuildId();
+
+class XSession : public system::XObject {
+ public:
+  static const Type kObjectType = Type::Session;
+
+  explicit XSession(system::KernelState* kernel_state);
+
+  // The guest object: 4 bytes holding the handle (as XAM's).
+  X_STATUS Initialize();
+
+  struct Member {
+    uint64_t xuid = 0;
+    uint32_t user_index = 0xFE;  // XUserIndexNone
+    bool is_private = false;
+    bool local = false;
+  };
+
+  // Guards everything below: XGI messages for one session come from several threads.
+  std::mutex mutex;
+  bool created = false;
+  bool host = false;
+  bool deleted = false;
+  uint64_t session_id = 0;
+  uint64_t nonce = 0;
+  uint32_t flags = 0;
+  uint32_t user_index_host = 0xFE;
+  uint32_t max_public = 0;
+  uint32_t max_private = 0;
+  uint32_t game_type = 0;
+  uint32_t game_mode = 0;
+  uint32_t state = 0;  // XSESSION_STATE: 0 lobby, 2 in game
+  std::array<uint8_t, 0x3C> info = {};
+  std::map<uint64_t, Member> members;
+
+  uint32_t FilledPublic() const;
+  uint32_t FilledPrivate() const;
+};
+
+// XamSessionCreateHandle / XamSessionRefObjByHandle.
+X_RESULT CreateSessionHandle(uint32_t* handle_out);
+X_RESULT SessionObjectByHandle(uint32_t handle, uint32_t* guest_object_out);
+
+// XGI session messages; `obj_ptr` is the guest object from XamSessionRefObjByHandle.
+X_RESULT SessionCreate(uint32_t obj_ptr, uint32_t flags, uint32_t public_slots,
+                       uint32_t private_slots, uint32_t user_index, uint32_t session_info_ptr,
+                       uint32_t nonce_ptr);
+X_RESULT SessionDelete(uint32_t obj_ptr);
+X_RESULT SessionModify(uint32_t obj_ptr, uint32_t flags, uint32_t public_slots,
+                       uint32_t private_slots);
+X_RESULT SessionStart(uint32_t obj_ptr);
+X_RESULT SessionEnd(uint32_t obj_ptr);
+X_RESULT SessionJoin(uint32_t obj_ptr, uint32_t count, uint32_t xuids_ptr, uint32_t indices_ptr,
+                     uint32_t private_ptr);
+X_RESULT SessionLeave(uint32_t obj_ptr, uint32_t count, uint32_t xuids_ptr,
+                      uint32_t indices_ptr);
+X_RESULT SessionDetails(uint32_t obj_ptr, uint32_t size_ptr, uint32_t details_ptr);
+X_RESULT SessionSearch(uint32_t search_index, uint32_t user_index, uint32_t max_results,
+                       uint32_t num_contexts, uint32_t contexts_ptr, uint32_t buffer_size,
+                       uint32_t results_ptr, uint32_t num_users);
+
+}  // namespace rex::kernel::xam::live
diff --git a/include/rex/kernel/xam/net_trace.h b/include/rex/kernel/xam/net_trace.h
new file mode 100644
index 0000000..5252128
--- /dev/null
+++ b/include/rex/kernel/xam/net_trace.h
@@ -0,0 +1,94 @@
+/**
+ * @file        net_trace.h
+ * @brief       --wwe_net_trace: a rate-limited log of the guest's network, XMsg and
+ *              session calls.
+ *
+ * A diagnostic for online play. Off by default; off, the wrapped exports behave exactly
+ * like REX_EXPORT / REX_EXPORT_STUB.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+
+#include <rex/cvar.h>
+#include <rex/hook.h>
+#include <rex/logging.h>
+#include <rex/system/kernel_state.h>
+
+REXCVAR_DECLARE(bool, wwe_net_trace);
+
+namespace rex::kernel::xam::net_trace {
+
+// Busy calls (a socket poll loop runs thousands a second) would rotate the log away:
+// each export logs its first 32 calls, then each power-of-two call.
+inline bool ShouldLog(const char* name, uint64_t* count) {
+  static std::mutex mutex;
+  static std::unordered_map<const char*, uint64_t> counts;
+  std::lock_guard lock(mutex);
+  *count = ++counts[name];
+  return *count <= 32 || (*count & (*count - 1)) == 0;
+}
+
+// A guest sockaddr_in as "a.b.c.d:port", for the export's address argument.
+inline std::string SockaddrText(uint32_t guest_address) {
+  if (!guest_address) {
+    return "null";
+  }
+  const uint8_t* p = REX_KERNEL_MEMORY()->TranslateVirtual<const uint8_t*>(guest_address);
+  return fmt::format("{}.{}.{}.{}:{} (family {})", p[4], p[5], p[6], p[7], (p[2] << 8) | p[3],
+                     (p[0] << 8) | p[1]);
+}
+
+// Raw argument registers before the call, r3 after it. NetDll_* imports take the
+// caller type in r3, so their real arguments start at r4. `sockaddr_reg` names the
+// register holding a sockaddr_in pointer to decode, or 0 for none.
+inline bool LogEnter(const char* name, const PPCContext& ctx, int sockaddr_reg = 0) {
+  uint64_t count = 0;
+  if (!ShouldLog(name, &count)) {
+    return false;
+  }
+  std::string address;
+  if (sockaddr_reg) {
+    const uint32_t regs[] = {ctx.r3.u32, ctx.r4.u32, ctx.r5.u32, ctx.r6.u32,
+                             ctx.r7.u32, ctx.r8.u32, ctx.r9.u32, ctx.r10.u32};
+    address = " addr=" + SockaddrText(regs[sockaddr_reg - 3]);
+  }
+  REXKRNL_INFO("[net] {}({:08X} {:08X} {:08X} {:08X} {:08X} {:08X} {:08X}){} #{}", name,
+               ctx.r3.u32, ctx.r4.u32, ctx.r5.u32, ctx.r6.u32, ctx.r7.u32, ctx.r8.u32, ctx.r9.u32,
+               address, count);
+  return true;
+}
+
+inline void LogLeave(const char* name, const PPCContext& ctx) {
+  REXKRNL_INFO("[net] {} -> {:08X}", name, ctx.r3.u32);
+}
+
+}  // namespace rex::kernel::xam::net_trace
+
+// REX_EXPORT with trace logging around the call.
+#define REX_TRACE_EXPORT_SOCKADDR(name, function, sockaddr_reg)                              \
+  extern "C" REX_FUNC(name) {                                                                \
+    const bool logged = REXCVAR_GET(wwe_net_trace) &&                                        \
+                        rex::kernel::xam::net_trace::LogEnter(#name, ctx, sockaddr_reg);     \
+    rex::ppc::HostToGuestFunction<function>(ctx, base);                                      \
+    if (logged) rex::kernel::xam::net_trace::LogLeave(#name, ctx);                           \
+  }                                                                                          \
+  static rex::ppc::detail::PPCFuncRegistrar _ppc_reg_##name(#name, &name);
+
+#define REX_TRACE_EXPORT(name, function) REX_TRACE_EXPORT_SOCKADDR(name, function, 0)
+
+// REX_EXPORT_STUB whose warning, with the trace on, goes through the trace's rate limit.
+#define REX_TRACE_EXPORT_STUB(name)                                              \
+  extern "C" REX_FUNC(name) {                                                    \
+    (void)base;                                                                  \
+    if (!REXCVAR_GET(wwe_net_trace)) {                                           \
+      REXKRNL_WARN("{} STUB", #name);                                            \
+    } else if (rex::kernel::xam::net_trace::LogEnter(#name " STUB", ctx)) {      \
+      rex::kernel::xam::net_trace::LogLeave(#name " STUB", ctx);                 \
+    }                                                                            \
+  }                                                                              \
+  static rex::ppc::detail::PPCFuncRegistrar _ppc_reg_##name(#name, &name);
diff --git a/include/rex/system/overlapped_receive.h b/include/rex/system/overlapped_receive.h
new file mode 100644
index 0000000..e16792a
--- /dev/null
+++ b/include/rex/system/overlapped_receive.h
@@ -0,0 +1,108 @@
+/**
+ * @file        overlapped_receive.h
+ * @brief       Overlapped (asynchronous) guest socket receives.
+ *
+ * A guest WSARecvFrom with an OVERLAPPED that finds no datagram stays pending, and
+ * WSAGetOverlappedResult tries it again until a datagram arrives. Titles that poll their
+ * sockets (Quazal's PRUDP) get their replies this way. Pure logic: the receive attempt,
+ * the clock and the sleep are passed in, so the export code supplies the host socket and
+ * the tests a fake one.
+ */
+
+#pragma once
+
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <unordered_map>
+
+namespace rex::system::net {
+
+// Guest-visible WSA error codes for these paths.
+inline constexpr uint32_t kWsaIoIncomplete = 996;
+inline constexpr uint32_t kWsaIoPending = 997;
+inline constexpr uint32_t kWsaEWouldBlock = 10035;
+
+// Pending receives by the guest address of their OVERLAPPED. `Request` holds what a later
+// attempt needs and a `socket` member (the guest socket handle). A receive attempt is a
+// callable taking the request and returning the datagram's size, or a negative value when
+// none is waiting.
+template <typename Request>
+class OverlappedReceives {
+ public:
+  enum class Status {
+    kCompleted,   // `bytes` received
+    kPending,     // WSARecvFrom: overlapped, nothing yet (WSA_IO_PENDING)
+    kWouldBlock,  // WSARecvFrom: not overlapped, nothing yet (WSAEWOULDBLOCK)
+    kIncomplete,  // WSAGetOverlappedResult: still pending (WSA_IO_INCOMPLETE)
+    kNotPending,  // WSAGetOverlappedResult: nothing outstanding; the OVERLAPPED holds the result
+  };
+  struct Outcome {
+    Status status;
+    int bytes = 0;
+  };
+
+  // WSARecvFrom. `overlapped` is 0 for a plain receive. A new receive on an OVERLAPPED
+  // that is still pending replaces the old one.
+  template <typename Receive>
+  Outcome Start(uint32_t overlapped, const Request& request, Receive&& receive) {
+    std::lock_guard lock(mutex_);
+    if (overlapped) {
+      pending_.erase(overlapped);
+    }
+    const int received = receive(request);
+    if (received >= 0) {
+      return {Status::kCompleted, received};
+    }
+    if (!overlapped) {
+      return {Status::kWouldBlock};
+    }
+    pending_[overlapped] = request;
+    return {Status::kPending};
+  }
+
+  // WSAGetOverlappedResult. Tries the pending receive until it completes or `wait` has
+  // passed (zero: one try), sleeping between tries.
+  template <typename Receive, typename Now, typename Sleep>
+  Outcome Poll(uint32_t overlapped, std::chrono::steady_clock::duration wait, Receive&& receive,
+               Now&& now, Sleep&& sleep) {
+    const auto give_up = now() + wait;
+    for (;;) {
+      {
+        // Under the lock, so two pollers of one OVERLAPPED can't both take a datagram.
+        std::lock_guard lock(mutex_);
+        auto it = pending_.find(overlapped);
+        if (it == pending_.end()) {
+          return {Status::kNotPending};
+        }
+        const int received = receive(it->second);
+        if (received >= 0) {
+          pending_.erase(it);
+          return {Status::kCompleted, received};
+        }
+      }
+      if (now() >= give_up) {
+        return {Status::kIncomplete};
+      }
+      sleep();
+    }
+  }
+
+  // closesocket: the socket's pending receives can never complete.
+  void Forget(uint32_t socket) {
+    std::lock_guard lock(mutex_);
+    std::erase_if(pending_, [socket](const auto& entry) { return entry.second.socket == socket; });
+  }
+
+  size_t pending() const {
+    std::lock_guard lock(mutex_);
+    return pending_.size();
+  }
+
+ private:
+  mutable std::mutex mutex_;
+  std::unordered_map<uint32_t, Request> pending_;
+};
+
+}  // namespace rex::system::net
