diff --git a/src/kernel/xam/live/http.cpp b/src/kernel/xam/live/http.cpp
new file mode 100644
index 0000000..729fa98
--- /dev/null
+++ b/src/kernel/xam/live/http.cpp
@@ -0,0 +1,70 @@
+/**
+ * @file        http.cpp
+ * @brief       The online client's HTTP requests (see http.h).
+ *
+ * After the Xenia netplay fork's XLiveAPI::Get/Post/Delete (src/xenia/kernel/XLiveAPI.cpp,
+ * Copyright 2026 Xenia Canary, BSD license).
+ */
+
+#include <rex/kernel/xam/live/http.h>
+
+#include <mutex>
+
+#include <curl/curl.h>
+
+#include <rex/logging.h>
+
+namespace rex::kernel::xam::live {
+
+namespace {
+
+size_t Append(void* data, size_t size, size_t count, void* body) {
+  static_cast<std::string*>(body)->append(static_cast<const char*>(data), size * count);
+  return size * count;
+}
+
+}  // namespace
+
+HttpResponse HttpRequest(const std::string& method, const std::string& url,
+                         const std::string& body) {
+  static std::once_flag global_init;
+  std::call_once(global_init, [] { curl_global_init(CURL_GLOBAL_DEFAULT); });
+
+  HttpResponse response;
+  CURL* curl = curl_easy_init();
+  if (!curl) {
+    REXKRNL_ERROR("[online] cannot initialize libcurl");
+    return response;
+  }
+  curl_slist* headers = nullptr;
+  headers = curl_slist_append(headers, "Content-Type: application/json");
+  headers = curl_slist_append(headers, "Accept: application/json");
+  curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
+  curl_easy_setopt(curl, CURLOPT_CUSTOMREQUEST, method.c_str());
+  curl_easy_setopt(curl, CURLOPT_HTTPHEADER, headers);
+  curl_easy_setopt(curl, CURLOPT_USERAGENT, "wweallstars");
+  curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT, 3L);
+  curl_easy_setopt(curl, CURLOPT_TIMEOUT, 8L);
+  curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);
+  curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, Append);
+  curl_easy_setopt(curl, CURLOPT_WRITEDATA, &response.body);
+  if (method == "POST") {
+    curl_easy_setopt(curl, CURLOPT_POSTFIELDS, body.c_str());
+    curl_easy_setopt(curl, CURLOPT_POSTFIELDSIZE_LARGE, curl_off_t(body.size()));
+  }
+  const CURLcode result = curl_easy_perform(curl);
+  if (result == CURLE_OK) {
+    curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &response.status);
+    char* local_ip = nullptr;
+    if (curl_easy_getinfo(curl, CURLINFO_LOCAL_IP, &local_ip) == CURLE_OK && local_ip) {
+      response.local_ip = local_ip;
+    }
+  } else {
+    REXKRNL_ERROR("[online] {} {}: {}", method, url, curl_easy_strerror(result));
+  }
+  curl_slist_free_all(headers);
+  curl_easy_cleanup(curl);
+  return response;
+}
+
+}  // namespace rex::kernel::xam::live
diff --git a/src/kernel/xam/live/identity.cpp b/src/kernel/xam/live/identity.cpp
new file mode 100644
index 0000000..9da3ba6
--- /dev/null
+++ b/src/kernel/xam/live/identity.cpp
@@ -0,0 +1,112 @@
+/**
+ * @file        identity.cpp
+ * @brief       The install's online identity (see identity.h).
+ */
+
+#include <rex/kernel/xam/live/identity.h>
+
+#include <fstream>
+#include <sstream>
+
+#include <fmt/format.h>
+#include <rapidjson/document.h>
+
+namespace rex::kernel::xam::live {
+
+OnlineIdentity NewIdentity(std::mt19937_64& random) {
+  OnlineIdentity identity;
+  do {
+    identity.xuid = 0x0009000000000000ull | (random() & 0x0000FFFFFFFFFFFFull);
+  } while ((identity.xuid & 0x0000FFFFFFFFFFFFull) == 0);
+  const uint64_t bits = random();
+  for (size_t i = 0; i < identity.mac.size(); ++i) {
+    identity.mac[i] = uint8_t(bits >> (8 * i));
+  }
+  identity.mac[0] = uint8_t((identity.mac[0] & 0xFC) | 0x02);
+  return identity;
+}
+
+std::string MacText(const std::array<uint8_t, 6>& mac) {
+  return fmt::format("{:02x}{:02x}{:02x}{:02x}{:02x}{:02x}", mac[0], mac[1], mac[2], mac[3],
+                     mac[4], mac[5]);
+}
+
+std::optional<std::array<uint8_t, 6>> ParseMac(std::string_view text) {
+  std::string digits;
+  for (char c : text) {
+    if (c != ':' && c != '-') {
+      digits.push_back(c);
+    }
+  }
+  if (digits.size() != 12) {
+    return std::nullopt;
+  }
+  std::array<uint8_t, 6> mac{};
+  for (size_t i = 0; i < mac.size(); ++i) {
+    unsigned value = 0;
+    for (size_t j = 0; j < 2; ++j) {
+      const char c = digits[i * 2 + j];
+      unsigned digit;
+      if (c >= '0' && c <= '9') {
+        digit = unsigned(c - '0');
+      } else if (c >= 'a' && c <= 'f') {
+        digit = unsigned(c - 'a' + 10);
+      } else if (c >= 'A' && c <= 'F') {
+        digit = unsigned(c - 'A' + 10);
+      } else {
+        return std::nullopt;
+      }
+      value = value * 16 + digit;
+    }
+    mac[i] = uint8_t(value);
+  }
+  return mac;
+}
+
+std::string SerializeIdentity(const OnlineIdentity& identity) {
+  return fmt::format("{{\n  \"xuid\": \"{:016X}\",\n  \"mac\": \"{}\"\n}}\n", identity.xuid,
+                     MacText(identity.mac));
+}
+
+std::optional<OnlineIdentity> ParseIdentity(std::string_view json) {
+  rapidjson::Document doc;
+  doc.Parse(json.data(), json.size());
+  if (doc.HasParseError() || !doc.IsObject() || !doc.HasMember("xuid") ||
+      !doc["xuid"].IsString() || !doc.HasMember("mac") || !doc["mac"].IsString()) {
+    return std::nullopt;
+  }
+  OnlineIdentity identity;
+  try {
+    identity.xuid = std::stoull(doc["xuid"].GetString(), nullptr, 16);
+  } catch (...) {
+    return std::nullopt;
+  }
+  const auto mac = ParseMac(doc["mac"].GetString());
+  if ((identity.xuid >> 48) != 0x0009 || !mac) {
+    return std::nullopt;
+  }
+  identity.mac = *mac;
+  return identity;
+}
+
+OnlineIdentity LoadOrCreateIdentity(const std::filesystem::path& folder,
+                                    std::mt19937_64& random) {
+  const auto file = folder / kIdentityFileName;
+  {
+    std::ifstream in(file, std::ios::binary);
+    if (in) {
+      std::stringstream text;
+      text << in.rdbuf();
+      if (auto identity = ParseIdentity(text.str())) {
+        return *identity;
+      }
+    }
+  }
+  const OnlineIdentity identity = NewIdentity(random);
+  std::error_code ignored;
+  std::filesystem::create_directories(folder, ignored);
+  std::ofstream(file, std::ios::binary | std::ios::trunc) << SerializeIdentity(identity);
+  return identity;
+}
+
+}  // namespace rex::kernel::xam::live
diff --git a/src/kernel/xam/live/live.cpp b/src/kernel/xam/live/live.cpp
new file mode 100644
index 0000000..414d786
--- /dev/null
+++ b/src/kernel/xam/live/live.cpp
@@ -0,0 +1,304 @@
+/**
+ * @file        live.cpp
+ * @brief       --wwe_online: Xbox LIVE sign-in against the game server (see live.h).
+ *
+ * After the Xenia netplay fork's XLiveAPI::Init, Getwhoami, RegisterPlayer, FindPlayer and
+ * GetServers (src/xenia/kernel/XLiveAPI.cpp, Copyright 2026 Xenia Canary, BSD license).
+ */
+
+#include <rex/kernel/xam/live/live.h>
+
+#include <chrono>
+#include <cstdlib>
+#include <mutex>
+#include <random>
+
+#include <fmt/format.h>
+
+#include <rex/kernel/xam/live/http.h>
+#include <rex/kernel/xam/live/identity.h>
+#include <rex/kernel/xam/live/relay.h>
+#include <rex/kernel/xam/live/upnp.h>
+#include <rex/kernel/xam/live/xsession.h>
+#include <rex/logging.h>
+#include <rex/runtime.h>
+#include <rex/system/kernel_state.h>
+#include <rex/system/xam/user_profile.h>
+
+REXCVAR_DEFINE_BOOL(wwe_online, false, "Kernel",
+                    "Online play (experimental): sign in to Xbox LIVE against the game server");
+REXCVAR_DEFINE_STRING(wwe_online_server, "https://allstars.komplexaci.cz", "Kernel",
+                      "Online play: the game server (host, host:port or URL; HTTP port 36000 "
+                      "for a bare host). The owner's server by default");
+REXCVAR_DEFINE_STRING(wwe_online_ip, "", "Kernel",
+                      "Online play: bind every socket to this address, e.g. 127.0.0.2 for a "
+                      "second copy on one PC");
+REXCVAR_DEFINE_STRING(wwe_online_name, "", "Kernel",
+                      "Online play: the name other players see (the profile's gamertag when "
+                      "empty)");
+
+namespace rex::kernel::xam::live {
+
+namespace {
+
+// A failed sign-in (server down) is retried this often, not on every call.
+constexpr auto kRetryInterval = std::chrono::seconds(10);
+
+struct State {
+  std::mutex mutex;
+  bool identity_loaded = false;
+  OnlineIdentity identity;
+  bool signed_in = false;
+  std::chrono::steady_clock::time_point last_attempt{};
+  uint32_t online_address = 0;
+  uint32_t local_address = 0;
+  bool servers_cached = false;
+  std::vector<TitleServer> servers;
+};
+
+State& state() {
+  static State s;
+  return s;
+}
+
+std::string Url(const std::string& endpoint) {
+  return ApiBaseUrl(REXCVAR_GET(wwe_online_server)) + endpoint;
+}
+
+std::string AddressText(uint32_t address) {
+  return fmt::format("{}.{}.{}.{}", address >> 24, (address >> 16) & 0xFF,
+                     (address >> 8) & 0xFF, address & 0xFF);
+}
+
+void LoadIdentity(State& s) {
+  if (s.identity_loaded) {
+    return;
+  }
+  std::random_device device;
+  std::mt19937_64 random((uint64_t(device()) << 32) ^ device() ^
+                         uint64_t(std::chrono::steady_clock::now().time_since_epoch().count()));
+  const auto folder = REX_KERNEL_STATE()->emulator()->user_data_root();
+  s.identity = LoadOrCreateIdentity(folder, random);
+  s.identity_loaded = true;
+  REXKRNL_INFO("[online] identity XUID {:016X}, MAC {} ({})", s.identity.xuid,
+               MacText(s.identity.mac), (folder / kIdentityFileName).string());
+}
+
+// The registration's relay, for peers that cannot be reached directly.
+void ConfigureRelay(const std::string& registration_body, uint64_t xuid) {
+  const auto registration = ParseRegistration(registration_body);
+  const auto& address = registration ? registration->relay_address : std::string();
+  const auto colon = address.rfind(':');
+  const auto host = colon == std::string::npos ? std::nullopt
+                                               : ParseIPv4(address.substr(0, colon));
+  const auto token = registration ? relay::ParseToken(registration->relay_token) : std::nullopt;
+  int port = 0;
+  if (host) {
+    port = std::atoi(address.c_str() + colon + 1);
+  }
+  if (!host || !token || port <= 0 || port > 0xFFFF) {
+    REXKRNL_ERROR("[online] the game server offers no relay: every peer is reached directly");
+    return;
+  }
+  relay::Configure(*host, uint16_t(port), xuid, *token, BindAddress());
+}
+
+// whoami, then players: the server learns this copy's XUID, name, address and MAC. Runs
+// without the state lock; `identity` is loaded and only read meanwhile.
+bool SignIn(State& s, const OnlineIdentity& identity) {
+  const auto whoami = HttpRequest("GET", Url("whoami"));
+  const auto address_text = whoami.status == 200 ? ParseWhoami(whoami.body) : std::nullopt;
+  const auto address = address_text ? ParseIPv4(*address_text) : std::nullopt;
+  if (!address) {
+    REXKRNL_ERROR("[online] the game server at {} did not answer whoami (HTTP {})",
+                  Url(""), whoami.status);
+    return false;
+  }
+  const uint32_t local = BindAddress() ? BindAddress()
+                                       : ParseIPv4(whoami.local_ip).value_or(*address);
+  {
+    std::lock_guard lock(s.mutex);
+    s.online_address = *address;
+    s.local_address = local;
+  }
+
+  PlayerRecord player;
+  player.xuid = identity.xuid;
+  player.gamertag = Gamertag();
+  player.host_address = *address_text;
+  player.local_address = AddressText(local);
+  player.mac = identity.mac;
+  player.machine_id = 0xFA00000000000000ull | (identity.xuid & 0x0000FFFFFFFFFFFFull);
+  player.build_id = BuildId();
+  relay::ListenForProbes(BindAddress());
+  player.mapped_ports = upnp::MapPorts();
+  const auto registered = HttpRequest("POST", Url("players"), PlayerJson(player));
+  if (registered.status == 426) {
+    // The server runs another game version: the player has to update the port.
+    REXKRNL_ERROR("[online] the game server refused this version of the port: {}",
+                  ParseRefusal(registered.body).value_or("update to play online"));
+    return false;
+  }
+  if (registered.status != 201) {
+    REXKRNL_ERROR("[online] registering with the game server failed (HTTP {})",
+                  registered.status);
+    return false;
+  }
+  REXKRNL_INFO("[online] signed in to {} as {:016X} \"{}\" at {}, local {}", Url(""),
+               player.xuid, player.gamertag, *address_text, player.local_address);
+  if (const auto it = player.mapped_ports.find(relay::kProbePort);
+      it != player.mapped_ports.end()) {
+    const auto registration = ParseRegistration(registered.body);
+    if (registration && registration->reachable == true) {
+      REXKRNL_INFO("[online] UPnP: the game server reached this PC at {}:{}", *address_text,
+                   it->second);
+    } else {
+      REXKRNL_WARN("[online] UPnP: the game server could not reach this PC at {}:{}",
+                   *address_text, it->second);
+    }
+  }
+  ConfigureRelay(registered.body, player.xuid);
+  return true;
+}
+
+}  // namespace
+
+bool Enabled() {
+  return REXCVAR_GET(wwe_online);
+}
+
+bool SignedIn() {
+  if (!Enabled()) {
+    return false;
+  }
+  auto& s = state();
+  // One attempt at a time; callers wait for it, as the game expects an answer. The state
+  // lock stays free meanwhile, so the XUID, MAC and address calls never wait on HTTP.
+  static std::mutex attempt;
+  std::lock_guard attempt_lock(attempt);
+  OnlineIdentity identity;
+  {
+    std::lock_guard lock(s.mutex);
+    if (s.signed_in) {
+      return true;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (s.last_attempt != std::chrono::steady_clock::time_point{} &&
+        now - s.last_attempt < kRetryInterval) {
+      return false;
+    }
+    s.last_attempt = now;
+    LoadIdentity(s);
+    identity = s.identity;
+  }
+  const bool ok = SignIn(s, identity);
+  std::lock_guard lock(s.mutex);
+  s.signed_in = ok;
+  return ok;
+}
+
+uint64_t OnlineXuid() {
+  auto& s = state();
+  std::lock_guard lock(s.mutex);
+  LoadIdentity(s);
+  return s.identity.xuid;
+}
+
+std::array<uint8_t, 6> Mac() {
+  auto& s = state();
+  std::lock_guard lock(s.mutex);
+  LoadIdentity(s);
+  return s.identity.mac;
+}
+
+std::string Gamertag() {
+  const std::string& name = REXCVAR_GET(wwe_online_name);
+  if (!name.empty()) {
+    return name.substr(0, 15);
+  }
+  return REX_KERNEL_STATE()->user_profile()->name();
+}
+
+uint32_t BindAddress() {
+  return ParseIPv4(REXCVAR_GET(wwe_online_ip)).value_or(0);
+}
+
+uint32_t OnlineAddress() {
+  auto& s = state();
+  std::lock_guard lock(s.mutex);
+  return s.online_address;
+}
+
+uint32_t LocalAddress() {
+  auto& s = state();
+  std::lock_guard lock(s.mutex);
+  return s.local_address;
+}
+
+std::vector<TitleServer> TitleServers() {
+  if (!SignedIn()) {
+    return {};
+  }
+  auto& s = state();
+  std::lock_guard lock(s.mutex);
+  if (!s.servers_cached) {
+    const auto response = HttpRequest(
+        "GET", Url(fmt::format("title/{:08X}/servers", REX_KERNEL_STATE()->title_id())));
+    if (response.status == 200) {
+      s.servers = ParseTitleServers(response.body);
+      s.servers_cached = true;
+      for (const auto& server : s.servers) {
+        REXKRNL_INFO("[online] LSP server {} \"{}\"", AddressText(server.address),
+                     server.description);
+      }
+    } else {
+      REXKRNL_ERROR("[online] title server list failed (HTTP {})", response.status);
+    }
+  }
+  return s.servers;
+}
+
+void PostQosData(uint64_t session_id, const std::string& data) {
+  const auto response = HttpRequest(
+      "POST",
+      Url(fmt::format("title/{:08X}/sessions/{:016x}/qos", REX_KERNEL_STATE()->title_id(),
+                      session_id)),
+      data);
+  if (response.status != 201) {
+    REXKRNL_ERROR("[online] QoS data for {:016X} failed (HTTP {})", session_id, response.status);
+  }
+}
+
+std::string GetQosData(uint64_t session_id) {
+  const auto response = HttpRequest(
+      "GET", Url(fmt::format("title/{:08X}/sessions/{:016x}/qos", REX_KERNEL_STATE()->title_id(),
+                             session_id)));
+  return response.status == 200 ? response.body : std::string();
+}
+
+namespace {
+std::optional<PlayerRecord> FindPlayerBy(const std::string& query) {
+  if (!SignedIn()) {
+    return std::nullopt;
+  }
+  const auto response = HttpRequest("POST", Url("players/find"), query);
+  if (response.status != 201) {
+    return std::nullopt;
+  }
+  return ParsePlayer(response.body);
+}
+}  // namespace
+
+std::optional<PlayerRecord> FindPlayer(uint32_t address) {
+  return FindPlayerBy(fmt::format(R"({{"hostAddress":"{}"}})", AddressText(address)));
+}
+
+std::optional<PlayerRecord> FindPlayerByMac(const std::array<uint8_t, 6>& mac) {
+  return FindPlayerBy(fmt::format(R"({{"macAddress":"{}"}})", MacText(mac)));
+}
+
+std::optional<PlayerRecord> FindPlayerByXuid(uint64_t xuid) {
+  return FindPlayerBy(fmt::format(R"({{"xuid":"{:016X}"}})", xuid));
+}
+
+}  // namespace rex::kernel::xam::live
diff --git a/src/kernel/xam/live/relay.cpp b/src/kernel/xam/live/relay.cpp
new file mode 100644
index 0000000..2184179
--- /dev/null
+++ b/src/kernel/xam/live/relay.cpp
@@ -0,0 +1,467 @@
+/**
+ * @file        relay.cpp
+ * @brief       The peer transport through the game server's relay (see relay.h).
+ */
+
+#include <rex/kernel/xam/live/relay.h>
+
+#include <algorithm>
+#include <chrono>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <fmt/format.h>
+
+#include <rex/kernel/xam/live/addressing.h>
+#include <rex/kernel/xam/live/upnp.h>
+#include <rex/logging.h>
+#include <rex/thread.h>
+
+#if REX_PLATFORM_WIN32
+// NOTE: must be included last as it expects windows.h to already be included.
+#include <winsock2.h>  // NOLINT(build/include_order)
+#elif REX_PLATFORM_LINUX || REX_PLATFORM_MAC
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <sys/select.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#endif
+
+REXCVAR_DEFINE_BOOL(wwe_online_force_relay, false, "Kernel",
+                    "Online play (developer): send every peer's traffic through the game "
+                    "server's relay");
+REXCVAR_DEFINE_BOOL(wwe_online_drop_direct, false, "Kernel",
+                    "Online play (developer): drop direct peer traffic, so peers fall back "
+                    "to the relay");
+
+namespace rex::kernel::xam::live::relay {
+
+namespace {
+
+#if REX_PLATFORM_WIN32
+using Native = SOCKET;
+constexpr Native kNoSocket = INVALID_SOCKET;
+using AddressLength = int;
+void CloseNative(Native s) {
+  closesocket(s);
+}
+#else
+using Native = int;
+constexpr Native kNoSocket = -1;
+using AddressLength = socklen_t;
+void CloseNative(Native s) {
+  close(s);
+}
+#endif
+
+using Clock = std::chrono::steady_clock;
+constexpr auto kHelloUntilWelcome = std::chrono::seconds(1);
+constexpr auto kKeepAlive = std::chrono::seconds(10);
+constexpr auto kPingInterval = std::chrono::seconds(2);
+constexpr auto kReportInterval = std::chrono::seconds(10);
+// A direct probe: this many tries this far apart, then the peer goes through the relay.
+constexpr int kProbeTries = 6;
+constexpr auto kProbeEvery = std::chrono::milliseconds(100);
+
+sockaddr_in Endpoint(uint32_t address, uint16_t port) {
+  sockaddr_in out{};
+  out.sin_family = AF_INET;
+  out.sin_addr.s_addr = htonl(address);
+  out.sin_port = htons(port);
+  return out;
+}
+
+std::string AddressText(uint32_t address) {
+  return fmt::format("{}.{}.{}.{}", address >> 24, (address >> 16) & 0xFF,
+                     (address >> 8) & 0xFF, address & 0xFF);
+}
+
+// A UDP socket bound to address:port, or kNoSocket.
+Native OpenUdp(uint32_t address, uint16_t port) {
+  Native s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  if (s == kNoSocket) {
+    return kNoSocket;
+  }
+#if REX_PLATFORM_WIN32
+  // A datagram to a closed port must not fail the next receive (WSAECONNRESET).
+  constexpr DWORD kSioUdpConnReset = 0x9800000C;
+  BOOL report = FALSE;
+  DWORD returned = 0;
+  WSAIoctl(s, kSioUdpConnReset, &report, sizeof(report), nullptr, 0, &returned, nullptr,
+           nullptr);
+#endif
+  const auto name = Endpoint(address, port);
+  if (bind(s, reinterpret_cast<const sockaddr*>(&name), sizeof(name)) != 0) {
+    CloseNative(s);
+    return kNoSocket;
+  }
+  return s;
+}
+
+struct Pump {
+  uint32_t stand_in = 0;
+  uint16_t port = 0;
+  Native socket = kNoSocket;
+};
+
+struct State {
+  std::mutex mutex;
+  bool configured = false;
+  sockaddr_in relay{};
+  uint32_t relay_address = 0;
+  uint16_t relay_port = 0;
+  uint64_t xuid = 0;
+  Token token{};
+  uint32_t copy_address = 0;  // --wwe_online_ip, 0 when unset
+  uint32_t game_address = 0;  // where the game's peer sockets listen
+  Native socket = kNoSocket;
+  PeerTable table;
+  RouteTable routes;
+  bool relaying = false;  // some peer goes through the relay: ping it
+  std::vector<Pump> pumps;
+};
+
+State& state() {
+  static State s;
+  return s;
+}
+
+// Listens on a stand-in address at every peer port; the caller holds the state lock.
+bool OpenPumps(State& s, uint32_t stand_in) {
+  std::vector<Pump> opened;
+  for (const uint16_t port : kPeerPorts) {
+    const Native socket = OpenUdp(stand_in, port);
+    if (socket == kNoSocket) {
+      for (const auto& pump : opened) {
+        CloseNative(pump.socket);
+      }
+      return false;
+    }
+    opened.push_back({stand_in, port, socket});
+  }
+  s.pumps.insert(s.pumps.end(), opened.begin(), opened.end());
+  return true;
+}
+
+// The caller holds the state lock.
+std::optional<uint32_t> AddPeer(State& s, uint64_t xuid) {
+  const bool known = s.table.StandInFor(xuid).has_value();
+  const auto stand_in =
+      s.table.Add(xuid, [&](uint32_t address) { return OpenPumps(s, address); });
+  if (!stand_in) {
+    REXKRNL_ERROR("[online] relay: no stand-in address could be bound for {:016X}", xuid);
+  } else if (!known) {
+    REXKRNL_INFO("[online] relay: peer {:016X} at stand-in {}", xuid, AddressText(*stand_in));
+  }
+  return stand_in;
+}
+
+void SendToRelay(const State& s, const std::vector<uint8_t>& packet) {
+  sendto(s.socket, reinterpret_cast<const char*>(packet.data()), int(packet.size()), 0,
+         reinterpret_cast<const sockaddr*>(&s.relay), sizeof(s.relay));
+}
+
+uint64_t Micros(Clock::time_point t) {
+  return uint64_t(
+      std::chrono::duration_cast<std::chrono::microseconds>(t.time_since_epoch()).count());
+}
+
+// Pings answered since the last report, in milliseconds.
+struct RoundTrips {
+  std::vector<double> samples;
+  Clock::time_point last_report = Clock::now();
+
+  void Report(Clock::time_point now) {
+    if (now - last_report < kReportInterval || samples.empty()) {
+      return;
+    }
+    const auto [low, high] = std::minmax_element(samples.begin(), samples.end());
+    double sum = 0;
+    for (const double sample : samples) {
+      sum += sample;
+    }
+    REXKRNL_INFO(
+        "[online] relay round trip {:.1f} ms average, {:.1f} min, {:.1f} max ({} pings)",
+        sum / samples.size(), *low, *high, samples.size());
+    samples.clear();
+    last_report = now;
+  }
+};
+
+// A datagram from the relay.
+void FromRelay(State& s, const uint8_t* data, size_t size, bool& welcomed,
+               RoundTrips& round_trips) {
+  const auto message = Parse(data, size);
+  if (!message) {
+    return;
+  }
+  switch (message->kind) {
+    case Message::kWelcome:
+      if (!welcomed) {
+        REXKRNL_INFO("[online] relay at {}:{} welcomed {:016X}", AddressText(s.relay_address),
+                     s.relay_port, message->value);
+      }
+      welcomed = true;
+      break;
+    case Message::kPong:
+      round_trips.samples.push_back(double(Micros(Clock::now()) - message->value) / 1000.0);
+      break;
+    case Message::kDeliver: {
+      // From the peer's stand-in address and port to the game's own port.
+      std::lock_guard lock(s.mutex);
+      if (s.routes.Get(message->value) == Route::kUndecided) {
+        REXKRNL_INFO("[online] peer {:016X}: relay (it reached us through the relay)",
+                     message->value);
+      }
+      s.routes.Relayed(message->value);
+      s.relaying = true;
+      const auto stand_in = AddPeer(s, message->value);
+      if (!stand_in) {
+        break;
+      }
+      const auto pump = std::find_if(s.pumps.begin(), s.pumps.end(), [&](const Pump& p) {
+        return p.stand_in == *stand_in && p.port == message->src_port;
+      });
+      if (pump == s.pumps.end()) {
+        break;
+      }
+      const auto to = Endpoint(s.game_address, message->dst_port);
+      sendto(pump->socket, reinterpret_cast<const char*>(message->payload), int(message->size),
+             0, reinterpret_cast<const sockaddr*>(&to), sizeof(to));
+      break;
+    }
+  }
+}
+
+void Run() {
+  auto& s = state();
+  std::vector<uint8_t> buffer(2048);
+  bool welcomed = false;
+  RoundTrips round_trips;
+  Clock::time_point last_hello{}, last_ping{};
+  for (;;) {
+    const auto now = Clock::now();
+    if (now - last_hello >= (welcomed ? kKeepAlive : kHelloUntilWelcome)) {
+      SendToRelay(s, Hello(s.xuid, s.token));
+      last_hello = now;
+    }
+    bool relaying;
+    {
+      std::lock_guard lock(s.mutex);
+      relaying = s.relaying;
+    }
+    if (welcomed && relaying && now - last_ping >= kPingInterval) {
+      SendToRelay(s, Ping(Micros(now)));
+      last_ping = now;
+    }
+    round_trips.Report(now);
+
+    std::vector<Pump> pumps;
+    {
+      std::lock_guard lock(s.mutex);
+      pumps = s.pumps;
+    }
+    fd_set readable;
+    FD_ZERO(&readable);
+    FD_SET(s.socket, &readable);
+    Native highest = s.socket;
+    for (const auto& pump : pumps) {
+      FD_SET(pump.socket, &readable);
+      highest = std::max(highest, pump.socket);
+    }
+    timeval timeout{0, 50000};
+    if (select(int(highest + 1), &readable, nullptr, nullptr, &timeout) <= 0) {
+      continue;
+    }
+    if (FD_ISSET(s.socket, &readable)) {
+      const int n =
+          recv(s.socket, reinterpret_cast<char*>(buffer.data()), int(buffer.size()), 0);
+      if (n > 0) {
+        FromRelay(s, buffer.data(), size_t(n), welcomed, round_trips);
+      }
+    }
+    // The game sent to a stand-in address: wrap it for that peer.
+    for (const auto& pump : pumps) {
+      if (!FD_ISSET(pump.socket, &readable)) {
+        continue;
+      }
+      sockaddr_in from{};
+      AddressLength from_length = sizeof(from);
+      const int n = recvfrom(pump.socket, reinterpret_cast<char*>(buffer.data()),
+                             int(buffer.size()), 0, reinterpret_cast<sockaddr*>(&from),
+                             &from_length);
+      if (n < 0) {
+        continue;
+      }
+      std::optional<uint64_t> peer;
+      {
+        std::lock_guard lock(s.mutex);
+        peer = s.table.XuidAt(pump.stand_in);
+      }
+      if (peer) {
+        SendToRelay(s, Send(*peer, ntohs(from.sin_port), pump.port, buffer.data(), size_t(n)));
+      }
+    }
+  }
+}
+
+// Answers every probe on the socket, from the address it came from.
+void AnswerProbes(Native responder) {
+  uint8_t buffer[64];
+  for (;;) {
+    sockaddr_in from{};
+    AddressLength from_length = sizeof(from);
+    const int n = recvfrom(responder, reinterpret_cast<char*>(buffer), int(sizeof(buffer)), 0,
+                           reinterpret_cast<sockaddr*>(&from), &from_length);
+    if (n < 0) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(10));
+      continue;
+    }
+    const auto nonce = ParseProbe(buffer, size_t(n));
+    if (nonce && !REXCVAR_GET(wwe_online_drop_direct)) {
+      const auto answer = ProbeAnswer(*nonce);
+      sendto(responder, reinterpret_cast<const char*>(answer.data()), int(answer.size()), 0,
+             reinterpret_cast<const sockaddr*>(&from), from_length);
+    }
+  }
+}
+
+// Whether the peer at `address` answers a direct probe within kProbeTries * kProbeEvery.
+bool ProbeDirect(uint32_t copy_address, uint32_t address) {
+  const Native socket = OpenUdp(ImplicitBindAddress(address, copy_address), 0);
+  if (socket == kNoSocket) {
+    return false;
+  }
+  const uint64_t nonce = Micros(Clock::now()) ^ (uint64_t(address) << 32);
+  const auto probe = Probe(nonce);
+  const auto to = Endpoint(address, upnp::Peers().External(address, kProbePort));
+  uint8_t buffer[64];
+  bool answered = false;
+  for (int i = 0; i < kProbeTries && !answered; ++i) {
+    sendto(socket, reinterpret_cast<const char*>(probe.data()), int(probe.size()), 0,
+           reinterpret_cast<const sockaddr*>(&to), sizeof(to));
+    const auto deadline = Clock::now() + kProbeEvery;
+    for (auto now = Clock::now(); !answered && now < deadline; now = Clock::now()) {
+      fd_set readable;
+      FD_ZERO(&readable);
+      FD_SET(socket, &readable);
+      const auto wait =
+          std::chrono::duration_cast<std::chrono::microseconds>(deadline - now).count();
+      timeval timeout{};
+      timeout.tv_sec = decltype(timeout.tv_sec)(wait / 1000000);
+      timeout.tv_usec = decltype(timeout.tv_usec)(wait % 1000000);
+      if (select(int(socket + 1), &readable, nullptr, nullptr, &timeout) <= 0) {
+        continue;
+      }
+      const int n = recv(socket, reinterpret_cast<char*>(buffer), int(sizeof(buffer)), 0);
+      answered = n > 0 && ParseProbeAnswer(buffer, size_t(n)) == nonce;
+    }
+  }
+  CloseNative(socket);
+  return answered;
+}
+
+}  // namespace
+
+bool Forced() {
+  return REXCVAR_GET(wwe_online_force_relay);
+}
+
+void Configure(uint32_t relay_address, uint16_t relay_port, uint64_t own_xuid,
+               const Token& token, uint32_t copy_address) {
+  auto& s = state();
+  std::lock_guard lock(s.mutex);
+  if (s.configured) {
+    return;
+  }
+  s.socket = OpenUdp(0, 0);
+  if (s.socket == kNoSocket) {
+    REXKRNL_ERROR("[online] relay: cannot open a socket");
+    return;
+  }
+  s.relay = Endpoint(relay_address, relay_port);
+  s.relay_address = relay_address;
+  s.relay_port = relay_port;
+  s.xuid = own_xuid;
+  s.token = token;
+  s.copy_address = copy_address;
+  // A socket bound to every address is reached on loopback.
+  s.game_address = copy_address ? copy_address : 0x7F000001;
+  s.configured = true;
+  std::thread(Run).detach();
+}
+
+void ListenForProbes(uint32_t copy_address) {
+  static std::once_flag once;
+  std::call_once(once, [copy_address] {
+    const Native responder = OpenUdp(copy_address, kProbePort);
+    if (responder == kNoSocket) {
+      REXKRNL_ERROR("[online] cannot listen for direct probes on UDP {}", kProbePort);
+      return;
+    }
+    std::thread(AnswerProbes, responder).detach();
+  });
+}
+
+bool Configured() {
+  auto& s = state();
+  std::lock_guard lock(s.mutex);
+  return s.configured;
+}
+
+uint32_t AddressFor(uint64_t peer_xuid, uint32_t direct) {
+  auto& s = state();
+  Route route;
+  uint32_t copy_address;
+  {
+    std::lock_guard lock(s.mutex);
+    if (!s.configured) {
+      return direct;
+    }
+    if (Forced() && s.routes.Get(peer_xuid) == Route::kUndecided) {
+      REXKRNL_INFO("[online] peer {:016X}: relay (forced)", peer_xuid);
+      s.routes.Relayed(peer_xuid);
+    }
+    route = s.routes.Get(peer_xuid);
+    copy_address = s.copy_address;
+  }
+  if (route == Route::kUndecided) {
+    const auto start = Clock::now();
+    const bool answered = ProbeDirect(copy_address, direct);
+    const auto waited =
+        std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now() - start).count();
+    std::lock_guard lock(s.mutex);
+    route = s.routes.Settle(peer_xuid, answered);
+    if (route == Route::kDirect) {
+      REXKRNL_INFO("[online] peer {:016X}: direct at {} (probe answered in {} ms)", peer_xuid,
+                   AddressText(direct), waited);
+    } else {
+      REXKRNL_INFO("[online] peer {:016X}: relay ({} did not answer a direct probe in {} ms)",
+                   peer_xuid, AddressText(direct), waited);
+    }
+  }
+  if (route == Route::kDirect) {
+    return direct;
+  }
+  std::lock_guard lock(s.mutex);
+  s.relaying = true;
+  return AddPeer(s, peer_xuid).value_or(direct);
+}
+
+bool DropsDirect(uint32_t address, uint16_t port) {
+  return REXCVAR_GET(wwe_online_drop_direct) && IsPeerPort(port) && !PeerAt(address);
+}
+
+std::optional<uint64_t> PeerAt(uint32_t address) {
+  if (!IsLoopback(address)) {
+    return std::nullopt;
+  }
+  auto& s = state();
+  std::lock_guard lock(s.mutex);
+  return s.table.XuidAt(address);
+}
+
+}  // namespace rex::kernel::xam::live::relay
