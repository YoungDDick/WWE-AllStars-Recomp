+static uint32_t constantArrayTail(bool isPixelShader, const ConstantInfo& info)
+{
+#ifdef XR_XENOS_FIXES
+    // Pixel shaders have 256 float constants like vertex shaders, and the
+    // native renderer uploads all 256. An array declared past c224 gets the
