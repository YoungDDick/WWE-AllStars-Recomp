+// Whether a (p0)/(!p0) exec block needs its own guard: some instruction in it
+// is not predicated on the block's condition. When all of them are, the block
+// already behaves as the hardware does: with p0 against the condition nothing
+// runs, so nothing can change p0. Decodes the block the way the instruction
+// loop in recompile() does; keep the two in step.
+static bool predExecNeedsGuard(const be<uint32_t>* code, uint32_t address, uint32_t count,
+    uint32_t sequence, bool condition)
+{
+    auto instructionCode = code + address * 3;
+    for (uint32_t i = 0; i < count; i++, sequence >>= 2, instructionCode += 3)
+    {
+        union
+        {
+            VertexFetchInstruction vertexFetch;
+            TextureFetchInstruction textureFetch;
+            AluInstruction alu;
+            struct
+            {
+                uint32_t code0;
+                uint32_t code1;
+                uint32_t code2;
+            };
+        };
+        code0 = instructionCode[0];
+        code1 = instructionCode[1];
+        code2 = instructionCode[2];
+
+        if ((sequence & 0x1) != 0)
+        {
+            if (vertexFetch.opcode == FetchOpcode::VertexFetch)
+            {
+                if (!vertexFetch.isPredicated || vertexFetch.predicateCondition != condition)
+                    return true;
+            }
+            else if (textureFetch.opcode == FetchOpcode::TextureFetch || textureFetch.opcode == FetchOpcode::GetTextureWeights)
+            {
+                if (!textureFetch.isPredicated || textureFetch.predCondition != condition)
+                    return true;
+            }
+        }
+        else
+        {
+            if (!alu.isPredicated || alu.predicateCondition != condition)
+                return true;
+        }
+    }
+    return false;
+}
