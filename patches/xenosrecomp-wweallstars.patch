+// Whether the scalar op's text reads what the co-issued vector op writes: a
+// lane of its temp destination, or a0 after a vector MaxA.
+static bool scalarReadsVectorResult(std::string_view scalarText, const AluInstruction& instr, bool vectorWritesTemp)
+{
+    if (instr.vectorOpcode >= AluVectorOpcode::MaxA && scalarText.find("a0") != std::string_view::npos)
+        return true;
+
+    uint32_t writeMask = instr.vectorWriteMask;
+    if (!vectorWritesTemp || writeMask == 0)
+        return false;
+
+    const std::string reg = fmt::format("r{}.", uint32_t(instr.vectorDest));
+    for (size_t at = scalarText.find(reg); at != std::string_view::npos; at = scalarText.find(reg, at + 1))
+    {
+        const char before = at > 0 ? scalarText[at - 1] : ' ';
+        if (std::isalnum(static_cast<unsigned char>(before)) || before == '_')
+            continue;
+        for (size_t i = at + reg.size(); i < scalarText.size(); i++)
+        {
+            const size_t lane = std::string_view("xyzw").find(scalarText[i]);
+            if (lane == std::string_view::npos)
+                break;
+            if ((writeMask >> lane) & 1)
+                return true;
+        }
+    }
+    return false;
+}
+#endif
