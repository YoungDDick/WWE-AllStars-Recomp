+    const bool pastOldEnd = info.registerIndex + info.registerCount > 224;
+    const uint32_t fileSize = (isPixelShader && !pastOldEnd) ? 224 : 256;
+#else
+    const uint32_t fileSize = isPixelShader ? 224 : 256;
+#endif
+    return fileSize - info.registerIndex;
