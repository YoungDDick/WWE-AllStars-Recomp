# allstars.komplexaci.cz: the WWE All Stars recomp game server's XWS API (ticket 14).
# Installed by /opt/allstars/server/deploy/remote-deploy.sh; Rendez-Vous UDP goes
# straight to the container, not through nginx.
server {
    listen 80;
    listen [::]:80;
    server_name allstars.komplexaci.cz;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name allstars.komplexaci.cz;

    ssl_certificate     /etc/letsencrypt/live/allstars.komplexaci.cz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/allstars.komplexaci.cz/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 64k;

    location / {
        proxy_pass http://127.0.0.1:36000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Replaced, not appended: the server trusts this header from nginx only.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
